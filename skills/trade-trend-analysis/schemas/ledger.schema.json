{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trade-trend-analysis:ledger:v3.0-draft-1",
  "type": "object",
  "required": ["artifact_kind", "schema_version", "schema_ref", "producer_version", "created_at", "artifact_hash", "run_id", "session", "release_mode", "decision_date", "market_data_as_of", "market_data_captured_at", "information_cutoff", "effective_from", "publication_status", "publication_completeness", "global_data_health", "report_projection", "themes", "evidence_ref"],
  "properties": {
    "artifact_kind": {"const": "ledger"},
    "session": {"const": "PREOPEN"},
    "release_mode": {"enum": ["INTERNAL_GATE", "SHADOW", "OFFICIAL"]},
    "publication_status": {"enum": ["VALIDATED_NOT_PUBLISHED", "PUBLISHED", "AMENDED"]},
    "publication_completeness": {"enum": ["COMPLETE", "PARTIAL"]},
    "global_data_health": {"enum": ["OK", "PARTIAL"]},
    "themes": {"type": "array"},
    "report_projection": {"type": "object"}
  }
}
